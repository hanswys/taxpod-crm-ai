# Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgres://crm:crm@localhost:5433/crm
# Only if 5433 is taken: set the host port here and in DATABASE_URL above
# DB_PORT=5434

# Free key, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Run `npm run check:gemini` to list the models your key can use
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
